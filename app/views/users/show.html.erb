<div class="max-w-4xl mx-auto space-y-8">
  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 md:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
    <div class="flex items-center gap-5">
      <div class="w-20 h-20 rounded-2xl bg-gradient-to-tr from-red-600 to-amber-600 flex items-center justify-center text-white text-3xl font-black shadow-lg">
        <%= @user.name.first %>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-2xl md:text-3xl font-black text-white"><%= @user.name %></h1>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-600/20 text-red-400 border border-red-500/30">
            <%= @user.role_title %>
          </span>
        </div>
        <p class="text-xs text-slate-400 mt-1"><%= @user.email %></p>
        <% if @user.telegram_username.present? %>
          <div class="mt-2 text-xs text-cyan-400 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
            Telegram: <%= @user.telegram_username %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <%= link_to "Написать статью", new_blog_post_path, class: "px-4 py-2 bg-red-600 hover:bg-red-500 text-white font-semibold text-xs rounded-xl shadow-lg transition-colors" %>
      <%= button_to "Выйти", logout_path, method: :delete, class: "px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs rounded-xl transition-colors cursor-pointer" %>
    </div>
  </div>

  <% if @user.bio.present? %>
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-5">
      <h2 class="text-sm font-bold text-white mb-2">О себе</h2>
      <p class="text-xs text-slate-300 leading-relaxed"><%= @user.bio %></p>
    </div>
  <% end %>

  <div class="space-y-4">
    <div class="flex justify-between items-center">
      <h2 class="text-xl font-bold text-white">Мои статьи и отчеты</h2>
      <%= link_to "+ Новая публикация", new_blog_post_path, class: "text-xs text-red-400 hover:underline" %>
    </div>

    <% if @user.articles.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% @user.articles.each do |article| %>
          <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 hover:border-slate-700 transition-colors">
            <div class="text-[11px] font-semibold text-red-400 uppercase tracking-wider mb-1"><%= article.category_title %></div>
            <h3 class="font-bold text-white text-base mb-2"><%= link_to article.title, blog_post_path(article.slug), class: "hover:underline" %></h3>
            <p class="text-xs text-slate-400 line-clamp-2"><%= article.summary %></p>
            <div class="mt-4 pt-3 border-t border-slate-800 flex justify-between items-center text-[11px] text-slate-500">
              <span><%= article.created_at.strftime("%d.%m.%Y") %></span>
              <span>👁 <%= article.views_count %> • 💬 <%= article.comments.count %></span>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-slate-900/50 border border-dashed border-slate-800 rounded-xl p-8 text-center text-slate-400 text-xs">
        У вас пока нет опубликованных статей или отчетов с соревнований.
        <div class="mt-3">
          <%= link_to "Написать первый отчет", new_blog_post_path, class: "inline-block px-4 py-2 bg-red-600/10 text-red-400 hover:bg-red-600/20 rounded-lg font-semibold" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
