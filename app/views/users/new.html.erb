<div class="max-w-lg mx-auto my-12 bg-slate-900 border border-slate-800 rounded-2xl p-8 shadow-xl">
  <div class="text-center mb-8">
    <div class="w-12 h-12 bg-red-600/10 text-red-500 rounded-full flex items-center justify-center mx-auto mb-3">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
    </div>
    <h1 class="text-2xl font-bold text-white">Регистрация в клубе TrackDays</h1>
    <p class="text-slate-400 text-xs mt-1">Присоединяйтесь к сообществу пилотов и любителей автоспорта</p>
  </div>

  <% if @user.errors.any? %>
    <div class="p-4 mb-6 bg-rose-950/80 border border-rose-800 text-rose-200 rounded-xl text-xs space-y-1">
      <div class="font-bold">Ошибки заполнения формы:</div>
      <ul class="list-disc pl-4">
        <% @user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: users_path, local: true, class: "space-y-4" do |f| %>
    <div>
      <label class="block text-xs font-semibold text-slate-300 mb-1.5">Ваше имя или гоночный никнейм</label>
      <%= f.text_field :name, placeholder: "Михаил Алешин", class: "w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-red-500", required: true %>
    </div>

    <div>
      <label class="block text-xs font-semibold text-slate-300 mb-1.5">Email</label>
      <%= f.email_field :email, placeholder: "pilot@trackdays.ru", class: "w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-red-500", required: true %>
    </div>

    <div class="grid grid-cols-2 gap-3">
      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1.5">Пароль</label>
        <%= f.password_field :password, placeholder: "••••••••", class: "w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-red-500", required: true %>
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1.5">Подтверждение</label>
        <%= f.password_field :password_confirmation, placeholder: "••••••••", class: "w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-red-500", required: true %>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-3">
      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1.5">Роль в автоспорте</label>
        <%= f.select :role, [["Пилот / Участник", "pilot"], ["Владелец автодрома", "track_owner"], ["Организатор серии", "organizer"], ["Продавец техники / тюнинга", "seller"], ["Зритель / Фанат", "spectator"]], {}, class: "w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-red-500" %>
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1.5">Telegram (@username)</label>
        <%= f.text_field :telegram_username, placeholder: "@trackpilot", class: "w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-red-500" %>
      </div>
    </div>

    <div>
      <label class="block text-xs font-semibold text-slate-300 mb-1.5">О себе / Автомобиль / Опыт</label>
      <%= f.text_area :bio, rows: 2, placeholder: "Например: BMW M2 F87, участвую в RHHCC Super-Street...", class: "w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-red-500" %>
    </div>

    <%= f.submit "Зарегистрироваться", class: "w-full py-2.5 bg-red-600 hover:bg-red-500 text-white font-bold text-sm rounded-xl transition-colors cursor-pointer" %>
  <% end %>

  <div class="mt-6 pt-6 border-t border-slate-800 text-center text-xs text-slate-400">
    Уже есть аккаунт? <%= link_to "Войти", login_path, class: "text-red-400 font-semibold hover:underline" %>
  </div>
</div>
