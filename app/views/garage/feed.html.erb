<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-extrabold text-white tracking-tight flex items-center gap-3">
        <span class="text-red-500">⚡</span> Лента обновлений бортжурналов
      </h1>
      <p class="text-zinc-400 mt-1">Свежие события, доработки трековых авто и онборды пилотов сообщества</p>
    </div>
    <div>
      <%= link_to "← В Гараж", garage_path, class: "inline-flex items-center px-4 py-2 border border-zinc-700 rounded-lg text-sm font-medium text-zinc-300 hover:bg-zinc-800 transition" %>
    </div>
  </div>

  <div class="space-y-6">
    <% @entries.each do |entry| %>
      <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-6 hover:border-zinc-700 transition shadow">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-3">
          <div class="flex items-center gap-3">
            <span class="text-xs px-2.5 py-1 rounded bg-zinc-800 text-red-400 font-semibold border border-zinc-700">
              <%= entry.garage_car.car_class %>
            </span>
            <h3 class="text-lg font-bold text-white">
              <%= link_to entry.garage_car.display_name, garage_car_path(entry.garage_car), class: "hover:text-red-400 transition" %>
              <span class="text-zinc-500 font-normal text-sm">/ <%= entry.title %></span>
            </h3>
          </div>
          <span class="text-xs text-zinc-500"><%= entry.date || entry.created_at.strftime("%d.%m.%Y") %></span>
        </div>

        <% if entry.content.present? %>
          <p class="text-sm text-zinc-300 leading-relaxed mb-4"><%= entry.content %></p>
        <% end %>

        <% if entry.onboard_video_url.present? %>
          <div class="p-3 bg-zinc-950 rounded-lg border border-zinc-800 inline-flex items-center gap-3">
            <span class="text-red-500 font-bold">▶</span>
            <a href="<%= entry.onboard_video_url %>" target="_blank" rel="noopener" class="text-xs text-red-400 hover:underline">
              Смотреть онборд (<%= entry.onboard_video_platform.to_s.upcase %>) →
            </a>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
