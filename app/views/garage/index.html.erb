<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
    <div>
      <h1 class="text-3xl font-extrabold text-white tracking-tight flex items-center gap-3">
        <span class="text-red-500">🏎</span> Гараж сообщества
      </h1>
      <p class="text-zinc-400 mt-1">Боевые и трековые автомобили пилотов, спек-листы и подтвержденная телеметрия</p>
    </div>
    <div class="flex gap-3">
      <%= link_to garage_feed_path, class: "inline-flex items-center px-4 py-2 border border-zinc-700 rounded-lg text-sm font-medium text-zinc-300 hover:bg-zinc-800 transition" do %>
        <span>Лента бортжурналов</span>
      <% end %>
      <%= link_to new_garage_car_path, class: "inline-flex items-center px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm font-semibold rounded-lg shadow transition" do %>
        <span>+ Добавить авто</span>
      <% end %>
    </div>
  </div>

  <% if @car_of_the_week %>
    <!-- Car of the Week Hero -->
    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-zinc-900 via-zinc-900/90 to-red-950/40 border border-red-500/30 p-6 md:p-8 mb-10 shadow-2xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-red-500/20 text-red-400 border border-red-500/30 mb-4">
        ★ Машина недели
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7">
          <h2 class="text-3xl font-black text-white"><%= @car_of_the_week.display_name %></h2>
          <p class="text-zinc-400 mt-2 text-sm">
            Пилот: <%= link_to @car_of_the_week.pilot&.name || "Частный пилот", (@car_of_the_week.pilot ? pilot_path(@car_of_the_week.pilot) : "#"), class: "text-red-400 hover:underline font-medium" %>
          </p>

          <div class="grid grid-cols-3 sm:grid-cols-4 gap-4 my-6">
            <div class="bg-zinc-800/60 rounded-xl p-3 border border-zinc-700/50">
              <span class="text-xs text-zinc-400 block">Мощность</span>
              <span class="text-xl font-bold text-white"><%= @car_of_the_week.power_hp || "—" %> <span class="text-xs text-zinc-400 font-normal">л.с.</span></span>
            </div>
            <div class="bg-zinc-800/60 rounded-xl p-3 border border-zinc-700/50">
              <span class="text-xs text-zinc-400 block">Масса</span>
              <span class="text-xl font-bold text-white"><%= @car_of_the_week.mass_kg || "—" %> <span class="text-xs text-zinc-400 font-normal">кг</span></span>
            </div>
            <div class="bg-zinc-800/60 rounded-xl p-3 border border-zinc-700/50">
              <span class="text-xs text-zinc-400 block">Кг / л.с.</span>
              <span class="text-xl font-bold text-amber-400"><%= @car_of_the_week.weight_power_ratio || "—" %></span>
            </div>
            <div class="bg-zinc-800/60 rounded-xl p-3 border border-zinc-700/50">
              <span class="text-xs text-zinc-400 block">Класс</span>
              <span class="text-xl font-bold text-red-400"><%= @car_of_the_week.car_class %></span>
            </div>
          </div>

          <%= link_to "Перейти в карточку машины →", garage_car_path(@car_of_the_week), class: "inline-flex items-center text-sm font-semibold text-red-400 hover:text-red-300 transition" %>
        </div>
        <div class="lg:col-span-5">
          <img src="<%= @car_of_the_week.image_url.presence || 'https://images.unsplash.com/photo-1542282088-72c9c27ed0cd?auto=format&fit=crop&w=1200&q=80' %>" alt="<%= @car_of_the_week.display_name %>" class="w-full h-64 sm:h-72 object-cover rounded-xl border border-zinc-800 shadow-lg">
        </div>
      </div>
    </div>
  <% end %>

  <!-- Filter & Sort Bar -->
  <div class="flex flex-wrap items-center justify-between gap-4 bg-zinc-900 border border-zinc-800 rounded-xl p-4 mb-8">
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-xs font-semibold text-zinc-500 uppercase tracking-wider mr-2">Фильтры:</span>
      <%= link_to "Все", garage_path, class: "px-3 py-1.5 rounded-lg text-xs font-medium #{params[:filter].blank? && params[:car_class].blank? ? 'bg-red-600 text-white' : 'bg-zinc-800 text-zinc-300 hover:bg-zinc-700'}" %>
      <%= link_to "В аренде", garage_path(filter: "rent"), class: "px-3 py-1.5 rounded-lg text-xs font-medium #{params[:filter] == 'rent' ? 'bg-red-600 text-white' : 'bg-zinc-800 text-zinc-300 hover:bg-zinc-700'}" %>
      <%= link_to "С онбордами", garage_path(filter: "onboards"), class: "px-3 py-1.5 rounded-lg text-xs font-medium #{params[:filter] == 'onboards' ? 'bg-red-600 text-white' : 'bg-zinc-800 text-zinc-300 hover:bg-zinc-700'}" %>
      <%= link_to "GT / SuperSport", garage_path(car_class: "GT"), class: "px-3 py-1.5 rounded-lg text-xs font-medium #{params[:car_class] == 'GT' ? 'bg-red-600 text-white' : 'bg-zinc-800 text-zinc-300 hover:bg-zinc-700'}" %>
      <%= link_to "Touring / Club", garage_path(car_class: "Touring"), class: "px-3 py-1.5 rounded-lg text-xs font-medium #{params[:car_class] == 'Touring' ? 'bg-red-600 text-white' : 'bg-zinc-800 text-zinc-300 hover:bg-zinc-700'}" %>
    </div>

    <div class="flex items-center gap-2">
      <span class="text-xs font-semibold text-zinc-500 uppercase tracking-wider">Сортировка:</span>
      <%= link_to "Мощность ↓", garage_path(sort: "power", filter: params[:filter], car_class: params[:car_class]), class: "px-2.5 py-1 text-xs rounded border border-zinc-700 #{params[:sort] == 'power' ? 'text-red-400 border-red-500' : 'text-zinc-400 hover:text-white'}" %>
      <%= link_to "Кг/л.с. ↑", garage_path(sort: "ratio", filter: params[:filter], car_class: params[:car_class]), class: "px-2.5 py-1 text-xs rounded border border-zinc-700 #{params[:sort] == 'ratio' ? 'text-red-400 border-red-500' : 'text-zinc-400 hover:text-white'}" %>
      <%= link_to "Легкие ↑", garage_path(sort: "weight", filter: params[:filter], car_class: params[:car_class]), class: "px-2.5 py-1 text-xs rounded border border-zinc-700 #{params[:sort] == 'weight' ? 'text-red-400 border-red-500' : 'text-zinc-400 hover:text-white'}" %>
    </div>
  </div>

  <!-- Cars Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @cars.each do |car| %>
      <div class="bg-zinc-900 border border-zinc-800 hover:border-zinc-700 rounded-xl overflow-hidden shadow transition flex flex-col group">
        <div class="relative h-48 bg-zinc-950">
          <img src="<%= car.image_url.presence || 'https://images.unsplash.com/photo-1542282088-72c9c27ed0cd?auto=format&fit=crop&w=800&q=80' %>" alt="<%= car.display_name %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
          <div class="absolute top-3 left-3 flex gap-2">
            <span class="px-2.5 py-1 rounded bg-black/70 backdrop-blur text-xs font-semibold text-white border border-white/10">
              <%= car.car_class %>
            </span>
            <% if car.for_rent? %>
              <span class="px-2.5 py-1 rounded bg-emerald-600/90 text-xs font-semibold text-white">
                Аренда
              </span>
            <% end %>
          </div>
          <div class="absolute bottom-3 right-3">
            <span class="px-2 py-0.5 rounded bg-zinc-900/90 text-xs font-mono font-medium text-zinc-300">
              <%= car.drivetrain %>
            </span>
          </div>
        </div>

        <div class="p-5 flex-1 flex flex-col justify-between">
          <div>
            <h3 class="text-lg font-bold text-white group-hover:text-red-400 transition">
              <%= link_to car.display_name, garage_car_path(car) %>
            </h3>
            <p class="text-xs text-zinc-400 mt-1">
              Владелец: <%= car.pilot ? car.pilot.name : "Частный" %>
            </p>

            <div class="grid grid-cols-3 gap-2 my-4 text-center">
              <div class="bg-zinc-800/50 rounded-lg p-2 border border-zinc-800">
                <span class="text-[10px] text-zinc-400 block uppercase">Сила</span>
                <span class="text-sm font-bold text-white"><%= car.power_hp || "—" %> <span class="text-[10px] text-zinc-500 font-normal">hp</span></span>
              </div>
              <div class="bg-zinc-800/50 rounded-lg p-2 border border-zinc-800">
                <span class="text-[10px] text-zinc-400 block uppercase">Масса</span>
                <span class="text-sm font-bold text-white"><%= car.mass_kg || "—" %> <span class="text-[10px] text-zinc-500 font-normal">kg</span></span>
              </div>
              <div class="bg-zinc-800/50 rounded-lg p-2 border border-zinc-800">
                <span class="text-[10px] text-zinc-400 block uppercase">Удел.</span>
                <span class="text-sm font-bold text-amber-400"><%= car.weight_power_ratio || "—" %></span>
              </div>
            </div>

            <% if car.logbook_entries.any? %>
              <div class="text-xs text-zinc-400 flex items-center gap-1.5 mt-2">
                <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                <span>Записей в бортжурнале: <strong class="text-zinc-200"><%= car.logbook_entries.count %></strong></span>
              </div>
            <% end %>
          </div>

          <div class="mt-4 pt-4 border-t border-zinc-800 flex items-center justify-between">
            <span class="text-xs text-zinc-500"><%= car.year %> г.в.</span>
            <%= link_to "Подробнее →", garage_car_path(car), class: "text-xs font-semibold text-red-400 hover:text-red-300 transition" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
