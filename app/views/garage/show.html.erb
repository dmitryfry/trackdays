<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6">
    <%= link_to "← Назад в Гараж", garage_path, class: "text-xs font-semibold text-zinc-400 hover:text-white transition" %>
  </div>

  <!-- Car Card Header -->
  <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden shadow-2xl mb-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
      <div class="lg:col-span-7 relative h-72 lg:h-auto min-h-[320px] bg-zinc-950">
        <img src="<%= @car.image_url.presence || 'https://images.unsplash.com/photo-1542282088-72c9c27ed0cd?auto=format&fit=crop&w=1200&q=80' %>" alt="<%= @car.display_name %>" class="w-full h-full object-cover">
        <div class="absolute top-4 left-4 flex gap-2">
          <span class="px-3 py-1 rounded bg-black/70 backdrop-blur text-xs font-semibold text-white border border-white/10">
            <%= @car.car_class %>
          </span>
          <% if @car.for_rent? %>
            <span class="px-3 py-1 rounded bg-emerald-600/90 text-xs font-semibold text-white">
              В аренде
            </span>
          <% end %>
        </div>
      </div>

      <div class="lg:col-span-5 p-6 lg:p-8 flex flex-col justify-between">
        <div>
          <h1 class="text-3xl font-black text-white"><%= @car.display_name %></h1>
          <p class="text-zinc-400 text-sm mt-1">
            Пилот: <%= link_to @car.pilot&.name || "Частный владелец", (@car.pilot ? pilot_path(@car.pilot) : "#"), class: "text-red-400 hover:underline font-medium" %>
          </p>

          <!-- Key Metrics -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 my-6">
            <div class="bg-zinc-800/60 rounded-xl p-3 border border-zinc-700/50 text-center">
              <span class="text-[10px] uppercase text-zinc-400 block font-semibold">Мощность</span>
              <span class="text-lg font-bold text-white"><%= @car.power_hp || "—" %> <span class="text-xs text-zinc-400 font-normal">л.с.</span></span>
            </div>
            <div class="bg-zinc-800/60 rounded-xl p-3 border border-zinc-700/50 text-center">
              <span class="text-[10px] uppercase text-zinc-400 block font-semibold">Масса</span>
              <span class="text-lg font-bold text-white"><%= @car.mass_kg || "—" %> <span class="text-xs text-zinc-400 font-normal">кг</span></span>
            </div>
            <div class="bg-zinc-800/60 rounded-xl p-3 border border-zinc-700/50 text-center">
              <span class="text-[10px] uppercase text-zinc-400 block font-semibold">Кг / л.с.</span>
              <span class="text-lg font-bold text-amber-400"><%= @car.weight_power_ratio || "—" %></span>
            </div>
            <div class="bg-zinc-800/60 rounded-xl p-3 border border-zinc-700/50 text-center">
              <span class="text-[10px] uppercase text-zinc-400 block font-semibold">Привод</span>
              <span class="text-lg font-bold text-red-400"><%= @car.drivetrain %></span>
            </div>
          </div>

          <!-- Specs List -->
          <% if @car.specs.present? %>
            <div class="bg-zinc-950/60 border border-zinc-800 rounded-xl p-4 my-4">
              <h4 class="text-xs uppercase font-semibold text-zinc-400 mb-2">Спек-лист доработок</h4>
              <p class="text-xs text-zinc-300 whitespace-pre-line leading-relaxed"><%= @car.specs %></p>
            </div>
          <% end %>
        </div>

        <div class="pt-4 border-t border-zinc-800 flex items-center justify-between text-xs text-zinc-500">
          <span>Год выпуска: <%= @car.year || "—" %></span>
          <% if @best_lap.present? %>
            <span class="text-emerald-400 font-mono font-semibold">Рекорд круга: <%= @best_lap %></span>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Telemetry & Dyno Integration Row -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-5">
      <h3 class="text-sm font-bold text-white uppercase tracking-wider flex items-center gap-2 mb-3">
        <span class="text-red-500">⚡</span> Замеры мощности (GPSDyno)
      </h3>
      <% if @dyno_run %>
        <div class="bg-zinc-950/70 rounded-lg p-4 border border-zinc-800 flex justify-between items-center">
          <div>
            <div class="text-sm font-semibold text-white"><%= @dyno_run.title %></div>
            <div class="text-xs text-zinc-400 mt-1"><%= @dyno_run.standard %> • <%= @dyno_run.run_date || "Недавно" %></div>
          </div>
          <div class="text-right">
            <div class="text-lg font-bold text-red-400"><%= @dyno_run.calculated_hp %> <span class="text-xs text-zinc-400 font-normal">л.с.</span></div>
            <div class="text-xs text-zinc-400"><%= @dyno_run.calculated_torque_nm %> Нм</div>
          </div>
        </div>
        <%= link_to "Открыть замер мощности →", gps_dyno_run_path(@dyno_run), class: "inline-block text-xs text-red-400 hover:underline mt-3" %>
      <% else %>
        <p class="text-xs text-zinc-500">Нет привязанных замеров виртуального стенда.</p>
      <% end %>
    </div>

    <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-5">
      <h3 class="text-sm font-bold text-white uppercase tracking-wider flex items-center gap-2 mb-3">
        <span class="text-red-500">⏱</span> Подтвержденное время треков
      </h3>
      <% if @car.pilot && @car.pilot.lap_results.any? %>
        <div class="space-y-2">
          <% @car.pilot.lap_results.limit(3).each do |lap| %>
            <div class="bg-zinc-950/70 rounded-lg px-3 py-2 border border-zinc-800 flex justify-between items-center text-xs">
              <span class="text-zinc-300 font-medium"><%= lap.event&.track&.name || "Трек-день" %></span>
              <span class="font-mono text-emerald-400 font-bold"><%= Time.at(lap.lap_time).utc.strftime("%M:%S.%L") rescue lap.lap_time %></span>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-xs text-zinc-500">Нет подтвержденных результатов хронометража.</p>
      <% end %>
    </div>
  </div>

  <!-- Logbook Entries & Onboards -->
  <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 lg:p-8">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-bold text-white flex items-center gap-2">
        <span class="text-red-500">📖</span> Бортжурнал и онборды (<%= @logbook_entries.count %>)
      </h2>
      <button onclick="document.getElementById('new-logbook-modal').classList.toggle('hidden')" class="px-3 py-1.5 bg-zinc-800 hover:bg-zinc-700 text-xs font-semibold text-white rounded-lg transition border border-zinc-700">
        + Новая запись
      </button>
    </div>

    <!-- Quick Add Entry Form Modal -->
    <div id="new-logbook-modal" class="hidden bg-zinc-950 border border-zinc-800 rounded-xl p-5 mb-6">
      <h3 class="text-sm font-bold text-white mb-3">Добавить событие в бортжурнал</h3>
      <%= form_with url: create_logbook_entry_path(@car), scope: :logbook_entry, method: :post, class: "space-y-3" do |f| %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <div>
            <%= f.label :title, "Заголовок записи", class: "block text-xs font-medium text-zinc-400 mb-1" %>
            <%= f.text_field :title, class: "w-full bg-zinc-900 border border-zinc-700 rounded-lg px-3 py-1.5 text-sm text-white focus:outline-none focus:border-red-500", required: true %>
          </div>
          <div>
            <%= f.label :date, "Дата события", class: "block text-xs font-medium text-zinc-400 mb-1" %>
            <%= f.date_field :date, value: Date.current, class: "w-full bg-zinc-900 border border-zinc-700 rounded-lg px-3 py-1.5 text-sm text-white focus:outline-none focus:border-red-500" %>
          </div>
        </div>
        <div>
          <%= f.label :onboard_video_url, "Ссылка на онборд (YouTube / VK Video / RuTube)", class: "block text-xs font-medium text-zinc-400 mb-1" %>
          <%= f.url_field :onboard_video_url, placeholder: "https://...", class: "w-full bg-zinc-900 border border-zinc-700 rounded-lg px-3 py-1.5 text-sm text-white focus:outline-none focus:border-red-500" %>
        </div>
        <div>
          <%= f.label :content, "Описание заезда / обслуживания", class: "block text-xs font-medium text-zinc-400 mb-1" %>
          <%= f.text_area :content, rows: 3, class: "w-full bg-zinc-900 border border-zinc-700 rounded-lg px-3 py-1.5 text-sm text-white focus:outline-none focus:border-red-500" %>
        </div>
        <div class="flex justify-end gap-2 pt-2">
          <button type="button" onclick="document.getElementById('new-logbook-modal').classList.add('hidden')" class="px-3 py-1.5 text-xs text-zinc-400 hover:text-white">Отмена</button>
          <%= f.submit "Сохранить запись", class: "px-4 py-1.5 bg-red-600 hover:bg-red-700 text-white text-xs font-bold rounded-lg cursor-pointer" %>
        </div>
      <% end %>
    </div>

    <!-- Timeline of Logbook Entries -->
    <% if @logbook_entries.any? %>
      <div class="space-y-6">
        <% @logbook_entries.each do |entry| %>
          <div class="bg-zinc-950/60 border border-zinc-800 rounded-xl p-5 hover:border-zinc-700 transition">
            <div class="flex items-center justify-between mb-2">
              <h4 class="text-base font-bold text-white"><%= entry.title %></h4>
              <span class="text-xs text-zinc-500"><%= entry.date || entry.created_at.strftime("%d.%m.%Y") %></span>
            </div>
            <% if entry.content.present? %>
              <p class="text-sm text-zinc-300 leading-relaxed mb-4"><%= entry.content %></p>
            <% end %>

            <% if entry.onboard_video_url.present? %>
              <div class="mt-3 p-3 bg-zinc-900 rounded-lg border border-zinc-800 inline-flex items-center gap-3">
                <span class="text-red-500 font-bold text-lg">▶</span>
                <div>
                  <span class="text-xs font-semibold text-white block">Онборд видео (<%= entry.onboard_video_platform.to_s.upcase %>)</span>
                  <a href="<%= entry.onboard_video_url %>" target="_blank" rel="noopener" class="text-xs text-red-400 hover:underline">
                    <%= entry.onboard_video_url %>
                  </a>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-zinc-500 text-sm">В бортжурнале пока нет записей. Добавьте первую запись с описанием доработок или онбордом!</p>
    <% end %>
  </div>
</div>
