<div class="space-y-8">
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 bg-slate-900 border border-slate-800 p-6 rounded-xl">
    <div>
      <div class="flex items-center gap-2 mb-2">
        <%= link_to "← К серверам", sim_servers_path, class: "text-xs text-cyan-400 hover:underline" %>
      </div>
      <h1 class="text-3xl font-extrabold text-white tracking-tight">Каталог гоночных модификаций Assetto Corsa</h1>
      <p class="text-slate-400 text-sm mt-1">Официальные лазерные сканы российских автодромов и подготовленные автомобили</p>
    </div>

    <div class="flex items-center gap-2">
      <%= link_to "Все", sim_mods_path, class: "px-3 py-1.5 rounded-lg text-xs font-semibold #{params[:type].blank? ? 'bg-cyan-600 text-white' : 'bg-slate-800 text-slate-300'}" %>
      <%= link_to "Автодромы", sim_mods_path(type: 'track'), class: "px-3 py-1.5 rounded-lg text-xs font-semibold #{params[:type] == 'track' ? 'bg-cyan-600 text-white' : 'bg-slate-800 text-slate-300'}" %>
      <%= link_to "Автомобили", sim_mods_path(type: 'car'), class: "px-3 py-1.5 rounded-lg text-xs font-semibold #{params[:type] == 'car' ? 'bg-cyan-600 text-white' : 'bg-slate-800 text-slate-300'}" %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <% @mods.each do |mod| %>
      <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden flex flex-col justify-between hover:border-slate-700 transition-all">
        <div class="h-44 bg-slate-950 overflow-hidden relative">
          <% if mod.image_url.present? %>
            <%= image_tag mod.image_url, class: "w-full h-full object-cover", alt: mod.title %>
          <% else %>
            <div class="w-full h-full flex items-center justify-center bg-slate-800 text-slate-500">
              <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
            </div>
          <% end %>
          <div class="absolute top-3 left-3 px-2 py-0.5 rounded text-xs font-bold uppercase bg-slate-900/90 text-slate-300 border border-slate-700">
            <%= mod.mod_type %>
          </div>
        </div>

        <div class="p-5 flex-1 flex flex-col justify-between">
          <div>
            <h3 class="font-bold text-white text-lg mb-1"><%= mod.title %></h3>
            <p class="text-xs text-slate-400 mb-3"><%= mod.description %></p>
            <div class="text-xs text-slate-500">Автор: <%= mod.author || 'Сообщество' %> • Версия: <%= mod.version || '1.0' %></div>
          </div>

          <div class="pt-4 mt-4 border-t border-slate-800">
            <a href="<%= mod.download_url %>" target="_blank" rel="noopener" class="w-full inline-flex items-center justify-center gap-2 px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white rounded-lg text-xs font-semibold transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Скачать мод
            </a>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
