<!DOCTYPE html>
<html lang="ru">
  <head>
    <title>TrackDays.ru - Amateur Motorsport</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= favicon_link_tag '/favicon.ico' %>
    <%= favicon_link_tag '/favicon.png', rel: 'icon', type: 'image/png' %>
    <%= favicon_link_tag '/apple-touch-icon.png', rel: 'apple-touch-icon', type: 'image/png' %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <style>
      /* Custom scrollbar for dark theme */
      ::-webkit-scrollbar {
        width: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #0f172a; 
      }
      ::-webkit-scrollbar-thumb {
        background: #334155; 
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #475569; 
      }
    </style>
  </head>

  <body class="bg-slate-950 text-slate-200 antialiased selection:bg-red-600 selection:text-white">
    <div class="min-h-screen flex flex-col bg-slate-950 text-slate-200">
      <!-- Navbar -->
      <nav class="sticky top-0 z-50 bg-slate-900/90 backdrop-blur-md border-b border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex items-center justify-between h-16">
            <div class="flex items-center">
              <%= link_to root_path, class: "flex items-center gap-2 group" do %>
                <div class="w-8 h-8 bg-gradient-to-br from-red-600 to-red-800 rounded flex items-center justify-center transform group-hover:skew-x-[-10deg] transition-transform">
                  <span class="font-bold text-white italic">T</span>
                </div>
                <span class="font-bold text-xl tracking-tight text-white group-hover:text-red-500 transition-colors">
                  TrackDays<span class="text-red-600">.ru</span>
                </span>
              <% end %>
            </div>
            
            <!-- Desktop Menu -->
            <div class="hidden md:block">
              <div class="ml-10 flex items-baseline space-x-3">
                <%= link_to root_path, class: "flex items-center gap-1.5 px-3 py-2 rounded-md text-sm font-medium transition-colors #{request.path == root_path ? 'bg-red-600/10 text-red-500' : 'text-slate-300 hover:text-white hover:bg-slate-800'}" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
                  Главная
                <% end %>
                <%= link_to calendar_path, class: "flex items-center gap-1.5 px-3 py-2 rounded-md text-sm font-medium transition-colors #{request.path == calendar_path ? 'bg-red-600/10 text-red-500' : 'text-slate-300 hover:text-white hover:bg-slate-800'}" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                  Календарь
                <% end %>
                <%= link_to timing_path, class: "flex items-center gap-1.5 px-3 py-2 rounded-md text-sm font-medium transition-colors #{request.path.start_with?('/timing') ? 'bg-red-600/10 text-red-500' : 'text-slate-300 hover:text-white hover:bg-slate-800'}" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  Live Timing
                <% end %>
                <%= link_to championships_path, class: "flex items-center gap-1.5 px-3 py-2 rounded-md text-sm font-medium transition-colors #{request.path.start_with?('/championships') ? 'bg-red-600/10 text-red-500' : 'text-slate-300 hover:text-white hover:bg-slate-800'}" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
                  Чемпионаты
                <% end %>
                <%= link_to pilots_path, class: "flex items-center gap-1.5 px-3 py-2 rounded-md text-sm font-medium transition-colors #{request.path.start_with?('/pilots') ? 'bg-red-600/10 text-red-500' : 'text-slate-300 hover:text-white hover:bg-slate-800'}" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                  Пилоты
                <% end %>
                <%= link_to garage_path, class: "flex items-center gap-1.5 px-3 py-2 rounded-md text-sm font-medium transition-colors #{request.path.start_with?('/garage') ? 'bg-red-600/10 text-red-500' : 'text-slate-300 hover:text-white hover:bg-slate-800'}" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C1.4 11.2 1 12 1 13v3c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg>
                  Гараж
                <% end %>
                <%= link_to market_path, class: "flex items-center gap-1.5 px-3 py-2 rounded-md text-sm font-medium transition-colors #{request.path.start_with?('/market') ? 'bg-red-600/10 text-red-500' : 'text-slate-300 hover:text-white hover:bg-slate-800'}" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                  Маркетплейс
                <% end %>
                <%= link_to sim_servers_path, class: "flex items-center gap-1.5 px-3 py-2 rounded-md text-sm font-medium transition-colors #{request.path.start_with?('/virtual') ? 'bg-red-600/10 text-red-500' : 'text-slate-300 hover:text-white hover:bg-slate-800'}" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                  Симрейсинг
                <% end %>
                <%= link_to booking_path, class: "flex items-center gap-1.5 px-3 py-2 rounded-md text-sm font-medium transition-colors #{request.path.start_with?('/booking') ? 'bg-red-600/10 text-red-500' : 'text-slate-300 hover:text-white hover:bg-slate-800'}" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                  Клуб
                <% end %>
                <%= link_to power_path, class: "flex items-center gap-1.5 px-3 py-2 rounded-md text-sm font-medium transition-colors #{request.path.start_with?('/power') ? 'bg-red-600/10 text-red-500' : 'text-slate-300 hover:text-white hover:bg-slate-800'}" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                  GPSDyno
                <% end %>
                <%= link_to tracks_path, class: "flex items-center gap-1.5 px-3 py-2 rounded-md text-sm font-medium transition-colors #{request.path == tracks_path ? 'bg-red-600/10 text-red-500' : 'text-slate-300 hover:text-white hover:bg-slate-800'}" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                  Автодромы
                <% end %>
                <%= link_to results_path, class: "flex items-center gap-1.5 px-3 py-2 rounded-md text-sm font-medium transition-colors #{request.path == results_path ? 'bg-red-600/10 text-red-500' : 'text-slate-300 hover:text-white hover:bg-slate-800'}" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
                  Результаты
                <% end %>
                <%= link_to blogs_path, class: "flex items-center gap-1.5 px-3 py-2 rounded-md text-sm font-medium transition-colors #{request.path.start_with?('/blogs') ? 'bg-red-600/10 text-red-500' : 'text-slate-300 hover:text-white hover:bg-slate-800'}" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
                  Блоги
                <% end %>
                <%= link_to news_path, class: "flex items-center gap-1.5 px-3 py-2 rounded-md text-sm font-medium transition-colors #{request.path == news_path ? 'bg-red-600/10 text-red-500' : 'text-slate-300 hover:text-white hover:bg-slate-800'}" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 20H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v1m2 13a2 2 0 0 1-2-2V7m2 13a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
                  Медиа
                <% end %>
                <%= link_to wiki_path, class: "flex items-center gap-1.5 px-3 py-2 rounded-md text-sm font-medium transition-colors #{request.path == wiki_path ? 'bg-red-600/10 text-red-500' : 'text-slate-300 hover:text-white hover:bg-slate-800'}" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 14.5h-2v-2h2zm0-4.5h-2V7h2z"/></svg>
                  AI Тренер
                <% end %>
              </div>
            </div>

            <!-- Header Actions: Search button & Auth -->
            <div class="hidden md:flex items-center space-x-3">
              <button type="button" id="omnisearch-open-btn" class="flex items-center gap-2 px-3 py-1.5 bg-slate-800/80 hover:bg-slate-700/80 border border-slate-700 rounded-lg text-slate-400 text-xs transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <span>Поиск</span>
                <kbd class="px-1.5 py-0.5 text-[10px] bg-slate-900 border border-slate-700 rounded text-slate-300">⌘K</kbd>
              </button>

              <% if logged_in? %>
                <div class="flex items-center space-x-2">
                  <%= link_to profile_path, class: "flex items-center gap-2 px-2.5 py-1.5 bg-slate-800 hover:bg-slate-700 rounded-lg text-sm text-slate-200 transition-colors" do %>
                    <div class="w-6 h-6 rounded-full bg-red-600 flex items-center justify-center text-xs font-bold text-white">
                      <%= current_user.name.first.upcase %>
                    </div>
                    <span><%= current_user.name.split.first %></span>
                  <% end %>
                  <%= button_to logout_path, method: :delete, class: "text-slate-400 hover:text-red-400 p-1.5 transition-colors", title: "Выйти" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                  <% end %>
                </div>
              <% else %>
                <div class="flex items-center space-x-2">
                  <%= link_to "Войти", login_path, class: "px-3 py-1.5 text-xs text-slate-300 hover:text-white transition-colors" %>
                  <%= link_to "Регистрация", register_path, class: "px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white text-xs font-medium rounded-lg transition-colors" %>
                </div>
              <% end %>
            </div>

            <!-- Mobile menu button -->
            <div class="md:hidden">
              <button id="mobile-menu-button" class="inline-flex items-center justify-center p-2 rounded-md text-slate-400 hover:text-white hover:bg-slate-800 focus:outline-none">
                <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>
          </div>
        </div>

        <!-- Mobile Menu -->
        <div id="mobile-menu" class="hidden md:hidden bg-slate-900 border-b border-slate-800">
          <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
            <%= link_to root_path, class: "flex items-center gap-3 px-3 py-3 rounded-md text-base font-medium #{request.path == root_path ? 'bg-red-900/20 text-red-500' : 'text-slate-300 hover:text-white hover:bg-slate-800'}" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
              Главная
            <% end %>
            <%= link_to calendar_path, class: "flex items-center gap-3 px-3 py-3 rounded-md text-base font-medium #{request.path == calendar_path ? 'bg-red-900/20 text-red-500' : 'text-slate-300 hover:text-white hover:bg-slate-800'}" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              Календарь
            <% end %>
            <%= link_to timing_path, class: "flex items-center gap-3 px-3 py-3 rounded-md text-base font-medium #{request.path.start_with?('/timing') ? 'bg-red-900/20 text-red-500' : 'text-slate-300 hover:text-white hover:bg-slate-800'}" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              Live Timing
            <% end %>
            <%= link_to championships_path, class: "flex items-center gap-3 px-3 py-3 rounded-md text-base font-medium #{request.path.start_with?('/championships') ? 'bg-red-900/20 text-red-500' : 'text-slate-300 hover:text-white hover:bg-slate-800'}" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
              Чемпионаты
            <% end %>
            <%= link_to pilots_path, class: "flex items-center gap-3 px-3 py-3 rounded-md text-base font-medium #{request.path.start_with?('/pilots') ? 'bg-red-900/20 text-red-500' : 'text-slate-300 hover:text-white hover:bg-slate-800'}" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              Пилоты
            <% end %>
            <%= link_to market_path, class: "flex items-center gap-3 px-3 py-3 rounded-md text-base font-medium #{request.path.start_with?('/market') ? 'bg-red-900/20 text-red-500' : 'text-slate-300 hover:text-white hover:bg-slate-800'}" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
              Маркетплейс
            <% end %>
            <%= link_to sim_servers_path, class: "flex items-center gap-3 px-3 py-3 rounded-md text-base font-medium #{request.path.start_with?('/virtual') ? 'bg-red-900/20 text-red-500' : 'text-slate-300 hover:text-white hover:bg-slate-800'}" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
              Симрейсинг
            <% end %>
            <%= link_to booking_path, class: "flex items-center gap-3 px-3 py-3 rounded-md text-base font-medium #{request.path.start_with?('/booking') ? 'bg-red-900/20 text-red-500' : 'text-slate-300 hover:text-white hover:bg-slate-800'}" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              Бронирование клуба
            <% end %>
            <%= link_to power_path, class: "flex items-center gap-3 px-3 py-3 rounded-md text-base font-medium #{request.path.start_with?('/power') ? 'bg-red-900/20 text-red-500' : 'text-slate-300 hover:text-white hover:bg-slate-800'}" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
              GPSDyno
            <% end %>
            <%= link_to tracks_path, class: "flex items-center gap-3 px-3 py-3 rounded-md text-base font-medium #{request.path == tracks_path ? 'bg-red-900/20 text-red-500' : 'text-slate-300 hover:text-white hover:bg-slate-800'}" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Автодромы
            <% end %>
            <%= link_to results_path, class: "flex items-center gap-3 px-3 py-3 rounded-md text-base font-medium #{request.path == results_path ? 'bg-red-900/20 text-red-500' : 'text-slate-300 hover:text-white hover:bg-slate-800'}" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
              Результаты
            <% end %>
            <%= link_to wiki_path, class: "flex items-center gap-3 px-3 py-3 rounded-md text-base font-medium #{request.path == wiki_path ? 'bg-red-900/20 text-red-500' : 'text-slate-300 hover:text-white hover:bg-slate-800'}" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
              AI Тренер
            <% end %>
            <%= link_to admin_path, class: "flex items-center gap-3 px-3 py-3 rounded-md text-base font-medium #{request.path == admin_path ? 'bg-red-900/20 text-red-500' : 'text-slate-300 hover:text-white hover:bg-slate-800'}" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              Админка
            <% end %>
          </div>
        </div>
      </nav>

      <!-- Main Content -->
      <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <%= yield %>
      </main>

      <!-- Footer -->
      <footer class="bg-slate-900 border-t border-slate-800 py-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-4">
          <div class="text-slate-500 text-sm">
            © 2024 TrackDays.ru. Любительский автоспорт.
          </div>
          <div class="flex gap-6">
            <a href="#" class="text-slate-400 hover:text-white text-sm">Правила</a>
            <a href="#" class="text-slate-400 hover:text-white text-sm">Контакты</a>
            <a href="#" class="text-slate-400 hover:text-white text-sm">Сотрудничество</a>
          </div>
        </div>
      </footer>
    </div>

    <!-- Global Omnisearch Cmd+K Modal -->
    <div id="omnisearch-modal" class="fixed inset-0 z-50 hidden bg-slate-950/80 backdrop-blur-sm flex items-start justify-center pt-20 px-4">
      <div class="bg-slate-900 border border-slate-700 w-full max-w-2xl rounded-2xl shadow-2xl overflow-hidden flex flex-col">
        <div class="flex items-center px-4 py-3 border-b border-slate-800 bg-slate-950/50">
          <svg class="text-slate-400 mr-3" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" id="omnisearch-input" placeholder="Поиск по автодромам, событиям, пилотам, блогам, машинам..." class="w-full bg-transparent border-0 text-white placeholder-slate-400 focus:outline-none text-base" autocomplete="off" />
          <button id="omnisearch-close-btn" class="text-slate-400 hover:text-white text-xs px-2 py-1 rounded bg-slate-800 border border-slate-700">ESC</button>
        </div>
        <div id="omnisearch-results" class="max-h-96 overflow-y-auto p-4 space-y-2 text-sm">
          <div class="text-center text-slate-500 py-8">Начните вводить для поиска по всей платформе...</div>
        </div>
      </div>
    </div>

    <script>
      // Mobile menu & Omnisearch toggle
      document.addEventListener('DOMContentLoaded', function() {
        const menuButton = document.getElementById('mobile-menu-button');
        const mobileMenu = document.getElementById('mobile-menu');
        const menuIcon = document.getElementById('menu-icon');
        const closeIcon = document.getElementById('close-icon');
        
        if (menuButton && mobileMenu) {
          menuButton.addEventListener('click', function() {
            mobileMenu.classList.toggle('hidden');
            menuIcon.classList.toggle('hidden');
            closeIcon.classList.toggle('hidden');
          });
        }

        // Cmd+K search modal
        const searchModal = document.getElementById('omnisearch-modal');
        const searchInput = document.getElementById('omnisearch-input');
        const searchResults = document.getElementById('omnisearch-results');
        const openBtn = document.getElementById('omnisearch-open-btn');
        const closeBtn = document.getElementById('omnisearch-close-btn');

        function openSearch() {
          if (!searchModal) return;
          searchModal.classList.remove('hidden');
          searchInput.focus();
        }

        function closeSearch() {
          if (!searchModal) return;
          searchModal.classList.add('hidden');
          searchInput.value = '';
          searchResults.innerHTML = '<div class="text-center text-slate-500 py-8">Начните вводить для поиска по всей платформе...</div>';
        }

        if (openBtn) openBtn.addEventListener('click', openSearch);
        if (closeBtn) closeBtn.addEventListener('click', closeSearch);

        window.addEventListener('keydown', function(e) {
          if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
            e.preventDefault();
            if (searchModal && searchModal.classList.contains('hidden')) {
              openSearch();
            } else {
              closeSearch();
            }
          }
          if (e.key === 'Escape' && searchModal && !searchModal.classList.contains('hidden')) {
            closeSearch();
          }
        });

        if (searchModal) {
          searchModal.addEventListener('click', function(e) {
            if (e.target === searchModal) closeSearch();
          });
        }

        let debounceTimer;
        if (searchInput) {
          searchInput.addEventListener('input', function() {
            clearTimeout(debounceTimer);
            const query = searchInput.value.trim();
            if (query.length < 2) {
              searchResults.innerHTML = '<div class="text-center text-slate-500 py-8">Введите минимум 2 символа...</div>';
              return;
            }

            debounceTimer = setTimeout(() => {
              searchResults.innerHTML = '<div class="text-center text-slate-400 py-4">Поиск...</div>';
              fetch('/search?q=' + encodeURIComponent(query), {
                headers: { 'Accept': 'application/json' }
              })
              .then(res => res.json())
              .then(data => {
                if (data.results.length === 0) {
                  searchResults.innerHTML = '<div class="text-center text-slate-500 py-8">Ничего не найдено</div>';
                  return;
                }
                let html = '<div class="space-y-1">';
                data.results.forEach(item => {
                  html += `
                    <a href="${item.url}" class="flex items-center justify-between p-2.5 rounded-lg hover:bg-slate-800/80 transition-colors group">
                      <div>
                        <div class="font-medium text-white group-hover:text-red-400">${item.title}</div>
                        <div class="text-xs text-slate-400">${item.subtitle || ''}</div>
                      </div>
                      <span class="text-[10px] px-2 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700">${item.type}</span>
                    </a>
                  `;
                });
                html += '</div>';
                searchResults.innerHTML = html;
              })
              .catch(() => {
                searchResults.innerHTML = '<div class="text-center text-red-400 py-4">Ошибка поиска</div>';
              });
            }, 250);
          });
        }
      });
    </script>
  </body>
</html>
