<div class="max-w-2xl mx-auto space-y-6">
  <div class="border-b border-slate-800 pb-4">
    <h1 class="text-2xl font-bold text-white">Новый замер GPSDyno</h1>
    <p class="text-slate-400 text-sm mt-1">Загрузите CSV-лог с Dragy или RaceChrono, либо выполните тестовый расчет по параметрам авто.</p>
  </div>

  <%= form_with url: "/power", method: :post, multipart: true, class: "space-y-6 bg-slate-900 border border-slate-800 rounded-xl p-6" do |f| %>
    <div>
      <label class="block text-sm font-medium text-slate-300 mb-1">Название замера / Спецификация</label>
      <input type="text" name="title" placeholder="например: BMW M3 E92 DCT (Catless + Tune)" required class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-red-500 text-sm" />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-slate-300 mb-1">Марка и модель авто</label>
        <input type="text" name="car_model" placeholder="например: BMW M3" required class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-red-500 text-sm" />
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-300 mb-1">Фактическая масса с пилотом (кг)</label>
        <input type="number" name="car_mass_kg" value="1550" required class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-red-500 text-sm font-mono" />
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium text-slate-300 mb-1">Файл лога Dragy / RaceChrono (.csv) <span class="text-slate-500">(опционально)</span></label>
      <input type="file" name="log_file" accept=".csv,.txt" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-2 text-slate-400 text-sm file:mr-4 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-red-600 file:text-white hover:file:bg-red-700" />
      <p class="text-xs text-slate-500 mt-1">Если файл не прикреплен, будет рассчитана стандартная динамика 100-200 км/ч для указанной массы.</p>
    </div>

    <div class="pt-4 border-t border-slate-800 flex justify-end gap-3">
      <%= link_to "Отмена", power_path, class: "px-4 py-2 text-sm text-slate-400 hover:text-white transition" %>
      <button type="submit" class="px-6 py-2.5 bg-red-600 hover:bg-red-700 text-white rounded-lg text-sm font-semibold shadow-lg shadow-red-600/30 transition">
        Рассчитать мощность
      </button>
    </div>
  <% end %>
</div>
