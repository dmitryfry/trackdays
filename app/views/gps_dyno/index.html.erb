<div class="space-y-8">
  <!-- Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-6">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-3xl font-extrabold text-white tracking-tight">GPSDyno</h1>
        <span class="px-2.5 py-0.5 rounded text-xs font-semibold bg-red-600/20 text-red-400 border border-red-500/30">SAE J1349</span>
      </div>
      <p class="text-slate-400 text-sm mt-1">Виртуальный замер мощности двигателя и крутящего момента по логам разгона GPS без стенда</p>
    </div>

    <div>
      <%= link_to new_gps_dyno_path, class: "inline-flex items-center gap-2 px-5 py-2.5 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-lg text-sm shadow-lg shadow-red-600/30 transition" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Новый замер (Загрузить лог)
      <% end %>
    </div>
  </div>

  <!-- Leaderboard -->
  <div>
    <h2 class="text-xl font-bold text-white mb-4">Топ замеров мощности платформы</h2>

    <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden shadow-xl">
      <table class="w-full text-left text-sm text-slate-300">
        <thead class="bg-slate-950/60 text-xs uppercase text-slate-400 border-b border-slate-800">
          <tr>
            <th class="px-6 py-4 text-center w-12">#</th>
            <th class="px-6 py-4">Автомобиль / Проект</th>
            <th class="px-6 py-4">Пилот / Владелец</th>
            <th class="px-6 py-4 text-right">Масса</th>
            <th class="px-6 py-4 text-right font-bold text-red-400">Мощность (л.с.)</th>
            <th class="px-6 py-4 text-right">Крутящий момент</th>
            <th class="px-6 py-4 text-right">Дата</th>
            <th class="px-6 py-4 text-right">Детали</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60">
          <% @runs.each_with_index do |run, idx| %>
            <tr class="hover:bg-slate-800/40 transition">
              <td class="px-6 py-4 text-center font-bold text-slate-500"><%= idx + 1 %></td>
              <td class="px-6 py-4 font-semibold text-white">
                <%= run.title %>
                <div class="text-xs text-slate-400 font-normal"><%= run.car_model %></div>
              </td>
              <td class="px-6 py-4 text-slate-300"><%= run.pilot&.name || "Анонимный пилот" %></td>
              <td class="px-6 py-4 text-right font-mono"><%= run.car_mass_kg.round %> кг</td>
              <td class="px-6 py-4 text-right font-mono font-bold text-red-400 text-base"><%= run.calculated_hp %> л.с.</td>
              <td class="px-6 py-4 text-right font-mono"><%= run.calculated_torque_nm %> Н·м</td>
              <td class="px-6 py-4 text-right text-xs text-slate-500 font-mono"><%= run.run_date&.strftime("%d.%m.%Y") || run.created_at.strftime("%d.%m.%Y") %></td>
              <td class="px-6 py-4 text-right">
                <%= link_to "График P(v)", gps_dyno_run_path(run), class: "text-red-400 hover:text-red-300 font-medium text-xs" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
