<div class="max-w-3xl mx-auto space-y-6">
  <div class="bg-slate-900 border border-slate-800 p-6 rounded-2xl">
    <h1 class="text-2xl font-bold text-white mb-4">Поиск по платформе TrackDays</h1>
    <%= form_with url: search_path, method: :get, local: true, class: "flex gap-2" do |f| %>
      <%= f.text_field :q, value: @query, placeholder: "Название трассы, авто, пилот, статья...", class: "flex-1 bg-slate-950 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-red-500" %>
      <%= f.submit "Найти", class: "px-6 py-2.5 bg-red-600 hover:bg-red-500 text-white font-bold text-sm rounded-xl cursor-pointer transition-colors" %>
    <% end %>
  </div>

  <% if @results.present? %>
    <div class="space-y-3">
      <div class="text-xs text-slate-400">Найдено совпадений: <%= @results.count %></div>
      <% @results.each do |item| %>
        <div class="bg-slate-900 border border-slate-800 hover:border-slate-700 rounded-xl p-4 transition-colors">
          <div class="text-[11px] font-bold uppercase tracking-wider text-red-400 mb-1"><%= item[:type] %></div>
          <h2 class="text-base font-bold text-white mb-0.5"><%= link_to item[:title], item[:url], class: "hover:underline" %></h2>
          <div class="text-xs text-slate-400"><%= item[:subtitle] %></div>
        </div>
      <% end %>
    </div>
  <% elsif @query.present? %>
    <div class="p-8 text-center text-slate-500 text-sm bg-slate-900/50 rounded-xl border border-slate-800">
      По вашему запросу «<%= @query %>» ничего не найдено. Попробуйте изменить ключевые слова.
    </div>
  <% end %>
</div>
