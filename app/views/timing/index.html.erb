<div class="space-y-8">
  <!-- Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-6">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-3xl font-extrabold text-white tracking-tight">Live Timing</h1>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-red-500/10 text-red-400 border border-red-500/20">
          <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
          В эфире
        </span>
      </div>
      <p class="text-slate-400 text-sm mt-1">Трансляция сессий хронометража с автодромов России в реальном времени</p>
    </div>
  </div>

  <!-- Active Live Sessions -->
  <div>
    <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
      <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      Текущие активные заезды
    </h2>

    <% if @live_sessions.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <% @live_sessions.each do |session| %>
          <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-6 hover:border-red-500/50 transition-all flex flex-col justify-between">
            <div>
              <div class="flex justify-between items-start gap-4">
                <div>
                  <span class="text-xs uppercase tracking-wider text-red-400 font-semibold"><%= session.session_type.upcase %></span>
                  <h3 class="text-lg font-bold text-white mt-1"><%= session.name %></h3>
                  <div class="text-sm text-slate-400 mt-0.5"><%= session.track.name %> (<%= session.track.location %>)</div>
                </div>
                <span class="px-2.5 py-1 bg-red-600/20 border border-red-500/30 text-red-400 rounded text-xs font-semibold flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-ping"></span>
                  LIVE
                </span>
              </div>

              <div class="grid grid-cols-3 gap-2 mt-4 pt-4 border-t border-slate-800 text-center text-xs">
                <div class="bg-slate-950/50 p-2 rounded">
                  <div class="text-slate-500">Погода</div>
                  <div class="font-medium text-slate-300 mt-0.5"><%= session.weather_temp || "+22°C" %></div>
                </div>
                <div class="bg-slate-950/50 p-2 rounded">
                  <div class="text-slate-500">Трек</div>
                  <div class="font-medium text-slate-300 mt-0.5"><%= session.track_temp || "+29°C" %></div>
                </div>
                <div class="bg-slate-950/50 p-2 rounded">
                  <div class="text-slate-500">Покрытие</div>
                  <div class="font-medium text-slate-300 mt-0.5"><%= session.condition || "Сухо" %></div>
                </div>
              </div>
            </div>

            <div class="mt-6">
              <%= link_to timing_session_path(session), class: "w-full py-2.5 px-4 bg-red-600 hover:bg-red-700 text-white rounded-lg text-sm font-semibold flex items-center justify-center gap-2 transition" do %>
                Открыть тайминг сессии
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-slate-900/50 border border-slate-800/80 rounded-xl p-8 text-center text-slate-400">
        Сейчас на треках перерыв. Ознакомьтесь с архивом прошедших сессий или расписанием заездов.
      </div>
    <% end %>
  </div>

  <!-- Recent Finished Sessions Archive -->
  <div>
    <h2 class="text-xl font-bold text-white mb-4">Архив прошедших заездов</h2>
    <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
      <table class="w-full text-left text-sm text-slate-300">
        <thead class="bg-slate-950/60 text-xs uppercase text-slate-400 border-b border-slate-800">
          <tr>
            <th class="px-6 py-4">Дата / Сессия</th>
            <th class="px-6 py-4">Автодром</th>
            <th class="px-6 py-4">Тип заезда</th>
            <th class="px-6 py-4">Лучшее время</th>
            <th class="px-6 py-4 text-right">Действие</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60">
          <% @recent_sessions.each do |session| %>
            <% best_lap = session.lap_results.order(lap_time: :asc).first %>
            <tr class="hover:bg-slate-800/40 transition">
              <td class="px-6 py-4 font-semibold text-white">
                <%= session.name %>
                <div class="text-xs text-slate-500 font-normal"><%= session.started_at&.strftime("%d.%m.%Y %H:%M") || session.created_at.strftime("%d.%m.%Y") %></div>
              </td>
              <td class="px-6 py-4 text-slate-400"><%= session.track.name %></td>
              <td class="px-6 py-4"><span class="px-2 py-0.5 rounded text-xs bg-slate-800 text-slate-300"><%= session.session_type %></span></td>
              <td class="px-6 py-4 font-mono font-medium text-emerald-400"><%= best_lap&.formatted_lap_time || "-" %></td>
              <td class="px-6 py-4 text-right">
                <%= link_to "Смотреть круги", timing_session_path(session), class: "text-red-400 hover:text-red-300 font-medium text-xs" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
