<div class="space-y-8">
  <!-- Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-6">
    <div>
      <h1 class="text-3xl font-extrabold text-white tracking-tight">Гоночные команды</h1>
      <p class="text-slate-400 text-sm mt-1">Коллективы и гоночные структуры, выступающие в чемпионатах России</p>
    </div>
  </div>

  <!-- Teams Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @teams.each do |team| %>
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 hover:border-red-500/50 transition flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-start">
            <span class="px-2.5 py-0.5 rounded text-xs font-semibold uppercase bg-slate-800 text-slate-300"><%= team.city || "Россия" %></span>
            <div class="font-mono font-bold text-red-500 text-sm"><%= team.points %> pts</div>
          </div>

          <h3 class="text-xl font-bold text-white mt-3"><%= team.name %></h3>
          <p class="text-slate-400 text-sm mt-2 line-clamp-2"><%= team.description %></p>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-800/80 flex items-center justify-between">
          <div class="text-xs text-slate-500">
            Пилотов: <%= team.pilots.count %>
          </div>
          <%= link_to "Профиль команды →", team_path(team.slug), class: "text-sm font-semibold text-red-500 hover:text-red-400 transition" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
