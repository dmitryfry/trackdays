<div class="max-w-5xl mx-auto space-y-8">
  <!-- Breadcrumb -->
  <div class="flex items-center gap-2 text-sm text-slate-400">
    <%= link_to "Маркетплейс", market_path, class: "hover:text-white" %>
    <span>/</span>
    <%= link_to @listing.market_category.name, market_path(category_id: @listing.market_category_id), class: "hover:text-white" %>
    <span>/</span>
    <span class="text-slate-200 truncate max-w-xs"><%= @listing.title %></span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main Content (2 cols) -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Media Header -->
      <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden relative">
        <div class="h-96 w-full bg-slate-950 flex items-center justify-center">
          <% if @listing.image_url.present? %>
            <%= image_tag @listing.image_url, class: "w-full h-full object-cover", alt: @listing.title %>
          <% else %>
            <div class="text-slate-600 flex flex-col items-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              <span class="text-sm mt-2">Нет изображения</span>
            </div>
          <% end %>
        </div>

        <div class="p-6">
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <% case @listing.deal_type %>
            <% when "sale" %>
              <span class="px-2.5 py-1 text-xs font-bold rounded bg-red-600 text-white shadow-md">ПРОДАЖА</span>
            <% when "rent" %>
              <span class="px-2.5 py-1 text-xs font-bold rounded bg-amber-500 text-black shadow-md">АРЕНДА С ТЕХПОДДЕРЖКОЙ</span>
            <% when "want" %>
              <span class="px-2.5 py-1 text-xs font-bold rounded bg-blue-600 text-white shadow-md">СПРОС / ИЩУТ</span>
            <% end %>
            <span class="px-2.5 py-1 text-xs font-medium bg-slate-800 text-slate-300 rounded border border-slate-700">
              <%= @listing.market_category.name %>
            </span>
            <span class="text-xs text-slate-400 flex items-center gap-1 ml-auto">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <%= @listing.city %>
            </span>
          </div>

          <h1 class="text-2xl sm:text-3xl font-extrabold text-white mb-4">
            <%= @listing.title %>
          </h1>

          <div class="text-slate-300 text-sm leading-relaxed whitespace-pre-line border-t border-slate-800 pt-4">
            <%= @listing.description %>
          </div>
        </div>
      </div>

      <!-- Garage Car Integration Card (if linked) -->
      <% if @listing.garage_car.present? %>
        <% car = @listing.garage_car %>
        <div class="bg-slate-900 border border-emerald-500/30 rounded-xl p-6 relative overflow-hidden">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
              <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-white">Проверенная история из Гаража TrackDays</h3>
                <p class="text-xs text-emerald-400">Паспорт гоночного автомобиля с подтвержденной телеметрией</p>
              </div>
            </div>
            <%= link_to "Открыть в Гараже →", garage_car_path(car), class: "text-xs font-semibold text-emerald-400 hover:text-emerald-300" %>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-4 bg-slate-950/60 rounded-lg border border-slate-800">
            <div>
              <div class="text-xs text-slate-400">Автомобиль</div>
              <div class="text-sm font-bold text-white"><%= car.display_name %></div>
            </div>
            <div>
              <div class="text-xs text-slate-400">Мощность / Масса</div>
              <div class="text-sm font-bold text-white"><%= car.power_hp || '-' %> л.с. / <%= car.mass_kg || '-' %> кг</div>
            </div>
            <div>
              <div class="text-xs text-slate-400">Удельная масса</div>
              <div class="text-sm font-bold text-white"><%= car.weight_power_ratio || '-' %> кг/л.с.</div>
            </div>
            <div>
              <div class="text-xs text-slate-400">Класс</div>
              <div class="text-sm font-bold text-white"><%= car.car_class %></div>
            </div>
          </div>

          <% if car.specs.present? %>
            <div class="mt-4 text-xs text-slate-300 bg-slate-950/40 p-3 rounded border border-slate-800">
              <span class="font-semibold text-slate-400">Спецификация доработок:</span>
              <p class="mt-1"><%= car.specs %></p>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Sidebar / Seller Contact (1 col) -->
    <div class="space-y-6">
      <!-- Price & Contact Card -->
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 space-y-6">
        <div>
          <div class="text-xs text-slate-400 uppercase tracking-wider mb-1">Стоимость</div>
          <div class="text-3xl font-extrabold text-white text-red-500">
            <%= @listing.formatted_price %>
          </div>
          <% if @listing.deal_type == 'rent' %>
            <p class="text-xs text-slate-400 mt-1">Включает доставку на автодром и базовое техсопровождение</p>
          <% end %>
        </div>

        <div class="border-t border-slate-800 pt-5 space-y-4">
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Контакты продавца / арендатора</div>
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-full bg-slate-800 flex items-center justify-center font-bold text-lg text-white">
              <%= @listing.contact_name[0].upcase rescue 'U' %>
            </div>
            <div>
              <div class="font-bold text-white"><%= @listing.contact_name %></div>
              <% if @listing.pilot.present? %>
                <div class="text-xs text-red-400">Пилот TrackDays.ru: <%= link_to @listing.pilot.name, pilot_path(@listing.pilot), class: "hover:underline" %></div>
              <% else %>
                <div class="text-xs text-slate-400">Частное лицо</div>
              <% end %>
            </div>
          </div>

          <% if @listing.contact_phone.present? %>
            <div class="flex items-center gap-3 p-3 bg-slate-950 rounded-lg border border-slate-800">
              <svg class="text-red-500" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <div>
                <div class="text-xs text-slate-400">Телефон для связи:</div>
                <a href="tel:<%= @listing.contact_phone %>" class="font-bold text-white hover:text-red-400"><%= @listing.contact_phone %></a>
              </div>
            </div>
          <% end %>

          <% if @listing.contact_telegram.present? %>
            <div class="flex items-center gap-3 p-3 bg-slate-950 rounded-lg border border-slate-800">
              <svg class="text-sky-400" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              <div>
                <div class="text-xs text-slate-400">Telegram:</div>
                <a href="https://t.me/<%= @listing.contact_telegram.delete('@') %>" target="_blank" rel="noopener" class="font-bold text-sky-400 hover:underline">
                  @<%= @listing.contact_telegram.delete('@') %>
                </a>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
