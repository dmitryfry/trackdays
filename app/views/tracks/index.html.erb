<div>
  <h1 class="text-3xl font-bold text-white mb-8">Автодромы</h1>
  
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <% @tracks.each do |track| %>
      <div class="bg-slate-900 rounded-xl overflow-hidden border border-slate-800 hover:shadow-xl transition-all">
        <div class="h-48 overflow-hidden relative">
          <img 
            src="<%= track.image_url.presence || 'https://picsum.photos/800/400?random=' + track.id.to_s %>" 
            alt="<%= track.name %>" 
            class="w-full h-full object-cover transition-transform hover:scale-105 duration-700"
          />
          <div class="absolute top-4 right-4 bg-black/70 backdrop-blur-sm px-3 py-1 rounded-full text-xs font-bold text-white border border-white/10">
            <%= track.difficulty %>
          </div>
        </div>
        <div class="p-6">
          <h2 class="text-2xl font-bold text-white mb-2"><%= track.name %></h2>
          <p class="text-slate-400 text-sm mb-4 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <%= track.location %>
          </p>
          
          <div class="grid grid-cols-2 gap-4 mb-4">
            <div class="bg-slate-800/50 p-3 rounded-lg border border-slate-700/50">
              <div class="text-slate-500 text-xs uppercase font-bold mb-1">Длина</div>
              <div class="text-white font-mono flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-red-500"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                <%= track.length_km %> км
              </div>
            </div>
            <div class="bg-slate-800/50 p-3 rounded-lg border border-slate-700/50">
              <div class="text-slate-500 text-xs uppercase font-bold mb-1">Повороты</div>
              <div class="text-white font-mono flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-500"><path d="M16 3h5v5"/><path d="M8 3H3v5"/><path d="M12 22v-8.3a4 4 0 0 0-1.172-2.828L4 3"/><path d="m15 9 6-6"/><path d="M21 3v5h-5"/><path d="M21 14v5a2 2 0 0 1-2 2h-5"/><path d="M16 21H5a2 2 0 0 1-2-2v-5"/></svg>
                <%= track.turns %>
              </div>
            </div>
          </div>

          <p class="text-slate-300 text-sm leading-relaxed mb-4">
            <%= track.description %>
          </p>

          <button class="w-full py-2 bg-slate-800 hover:bg-slate-700 text-white rounded-lg text-sm font-medium transition-colors">
            Показать на карте
          </button>
        </div>
      </div>
    <% end %>
  </div>
</div>
