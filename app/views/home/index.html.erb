<div class="space-y-12">
  <!-- Hero Section -->
  <div class="relative rounded-2xl overflow-hidden bg-slate-900 shadow-2xl border border-slate-800">
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-900/80 to-transparent z-10"></div>
    <img 
      src="https://picsum.photos/1200/600?grayscale" 
      alt="Racing Track" 
      class="absolute inset-0 w-full h-full object-cover opacity-40"
    />
    <div class="relative z-20 p-8 md:p-16 max-w-2xl">
      <h1 class="text-4xl md:text-6xl font-extrabold text-white tracking-tight mb-6">
        Твой путь к <span class="text-red-600">подиуму</span> начинается здесь
      </h1>
      <p class="text-lg text-slate-300 mb-8 leading-relaxed">
        Присоединяйся к сообществу любительского автоспорта. Календарь трек-дней,
        регистрация на события, аналитика кругов и персональный AI тренер.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <%= link_to calendar_path, class: "px-6 py-3 bg-red-600 hover:bg-red-700 text-white font-bold rounded-lg flex items-center justify-center gap-2 transition-all transform hover:scale-105 shadow-lg shadow-red-900/20" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          Календарь событий
        <% end %>
        <%= link_to wiki_path, class: "px-6 py-3 bg-slate-800 hover:bg-slate-700 text-white font-semibold rounded-lg flex items-center justify-center gap-2 transition-all border border-slate-700" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          AI Тренер
        <% end %>
      </div>
    </div>
  </div>

  <!-- Features Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    <div class="bg-slate-900 p-6 rounded-xl border border-slate-800 hover:border-slate-700 transition-colors">
      <div class="w-12 h-12 bg-red-900/20 rounded-lg flex items-center justify-center mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      </div>
      <h3 class="text-xl font-bold text-white mb-2">Единый Календарь</h3>
      <p class="text-slate-400 text-sm">
        Все трек-дни Москвы и Санкт-Петербурга в одном месте. Удобная запись и оплата.
      </p>
    </div>
    <div class="bg-slate-900 p-6 rounded-xl border border-slate-800 hover:border-slate-700 transition-colors">
      <div class="w-12 h-12 bg-blue-900/20 rounded-lg flex items-center justify-center mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
      </div>
      <h3 class="text-xl font-bold text-white mb-2">Телеметрия</h3>
      <p class="text-slate-400 text-sm">
        Загружай свои логи, анализируй время круга и сравнивай с соперниками в классе.
      </p>
    </div>
    <div class="bg-slate-900 p-6 rounded-xl border border-slate-800 hover:border-slate-700 transition-colors">
      <div class="w-12 h-12 bg-emerald-900/20 rounded-lg flex items-center justify-center mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
      </div>
      <h3 class="text-xl font-bold text-white mb-2">Вики для Новичков</h3>
      <p class="text-slate-400 text-sm">
        База знаний и AI помощник ответят на вопросы о подготовке авто и технике пилотирования.
      </p>
    </div>
  </div>
</div>
