<div class="space-y-8">
  <!-- Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-6">
    <div>
      <h1 class="text-3xl font-extrabold text-white tracking-tight">Чемпионаты и гоночные серии</h1>
      <p class="text-slate-400 text-sm mt-1">Официальные и клубные соревнования России: кольцевые гонки, тайм-аттак, гонки на выносливость</p>
    </div>
  </div>

  <!-- Series Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @championships.each do |series| %>
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 hover:border-red-500/50 transition flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-start">
            <span class="px-2.5 py-0.5 rounded text-xs font-semibold uppercase tracking-wider bg-slate-800 text-slate-300">
              <%= series.category %>
            </span>
            <span class="text-xs text-emerald-400 font-medium">Активен</span>
          </div>

          <h3 class="text-xl font-bold text-white mt-3"><%= series.name %></h3>
          <p class="text-slate-400 text-sm mt-2 line-clamp-3"><%= series.description %></p>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-800/80 flex items-center justify-between">
          <div class="text-xs text-slate-500">
            Сезонов: <%= series.championship_seasons.count %>
          </div>
          <%= link_to "Таблицы и этапы →", championship_path(series.slug), class: "text-sm font-semibold text-red-500 hover:text-red-400 transition" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
