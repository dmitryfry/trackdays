<div class="space-y-8">
  <!-- Pilot Profile Header -->
  <div class="bg-slate-900 border border-slate-800 rounded-xl p-6">
    <div class="flex flex-col md:flex-row justify-between md:items-center gap-6">
      <div class="flex items-center gap-5">
        <div class="w-20 h-20 bg-slate-800 border-2 border-red-600 rounded-2xl flex items-center justify-center font-mono text-3xl font-black text-white shadow-xl shadow-red-600/20">
          #<%= @pilot.racing_number || "99" %>
        </div>
        <div>
          <div class="flex items-center gap-3">
            <h1 class="text-3xl font-extrabold text-white tracking-tight"><%= @pilot.name %></h1>
            <% if @pilot.team %>
              <span class="px-2.5 py-0.5 rounded text-xs font-semibold bg-red-600/20 text-red-400">
                <%= @pilot.team.name %>
              </span>
            <% end %>
          </div>
          <div class="text-sm text-slate-400 mt-1">
            <%= @pilot.hometown || "Москва" %> • Автомобиль: <span class="text-slate-200 font-semibold"><%= @pilot.car %></span> • Класс: <span class="text-slate-200 font-semibold"><%= @pilot.pilot_class %></span>
          </div>
        </div>
      </div>

      <!-- Stats Grid -->
      <div class="grid grid-cols-4 gap-3 text-center">
        <div class="bg-slate-950 p-3 rounded-lg border border-slate-800 min-w-[75px]">
          <div class="text-xs text-slate-500">Старты</div>
          <div class="text-xl font-bold font-mono text-white mt-0.5"><%= @pilot.starts_count %></div>
        </div>
        <div class="bg-slate-950 p-3 rounded-lg border border-slate-800 min-w-[75px]">
          <div class="text-xs text-slate-500">Победы</div>
          <div class="text-xl font-bold font-mono text-amber-400 mt-0.5"><%= @pilot.wins_count %></div>
        </div>
        <div class="bg-slate-950 p-3 rounded-lg border border-slate-800 min-w-[75px]">
          <div class="text-xs text-slate-500">Подиумы</div>
          <div class="text-xl font-bold font-mono text-slate-200 mt-0.5"><%= @pilot.podiums_count %></div>
        </div>
        <div class="bg-slate-950 p-3 rounded-lg border border-slate-800 min-w-[75px]">
          <div class="text-xs text-slate-500">Очки</div>
          <div class="text-xl font-bold font-mono text-red-500 mt-0.5"><%= @pilot.points %></div>
        </div>
      </div>
    </div>

    <% if @pilot.bio.present? %>
      <div class="mt-6 pt-4 border-t border-slate-800 text-sm text-slate-400">
        <%= @pilot.bio %>
      </div>
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Best Laptimes -->
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-6">
      <h2 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
        <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        Лучшие круги пилота
      </h2>

      <% if @best_laps.any? %>
        <div class="space-y-3 font-mono text-xs">
          <% @best_laps.each do |lap| %>
            <div class="flex justify-between items-center p-3 bg-slate-950 rounded-lg border border-slate-800/80">
              <div>
                <div class="text-white font-sans font-medium text-sm"><%= lap.timing_session&.track&.name || lap.event&.track&.name || "Автодром" %></div>
                <div class="text-slate-500 font-sans text-xs"><%= lap.timing_session&.name || lap.event&.title || "Трек-день" %></div>
              </div>
              <div class="text-right">
                <div class="text-emerald-400 font-bold text-sm"><%= lap.formatted_lap_time %></div>
                <% if lap.top_speed %>
                  <div class="text-slate-500"><%= lap.top_speed.round(1) %> км/ч</div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-slate-500 text-xs">Лучшее подтвержденное время: <span class="font-mono text-white"><%= @pilot.best_lap || "1:52.410" %></span></div>
      <% end %>
    </div>

    <!-- Dyno runs -->
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-6">
      <h2 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
        <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        Замеры мощности GPSDyno
      </h2>

      <% if @pilot.gps_dyno_runs.any? %>
        <div class="space-y-3">
          <% @pilot.gps_dyno_runs.each do |run| %>
            <div class="p-3 bg-slate-950 rounded-lg border border-slate-800 flex justify-between items-center">
              <div>
                <div class="font-semibold text-white text-sm"><%= run.title %></div>
                <div class="text-slate-500 text-xs"><%= run.car_model %> • <%= run.car_mass_kg.round %> кг</div>
              </div>
              <div class="text-right">
                <div class="text-red-400 font-mono font-bold text-base"><%= run.calculated_hp %> л.с.</div>
                <%= link_to "График P(v)", gps_dyno_run_path(run), class: "text-xs text-slate-400 hover:text-white" %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-slate-500 text-xs">Замеры мощности пока не привязаны.</div>
      <% end %>
    </div>
  </div>
</div>
