<div class="space-y-8">
  <!-- Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-6">
    <div>
      <h1 class="text-3xl font-extrabold text-white tracking-tight">Рейтинг пилотов</h1>
      <p class="text-slate-400 text-sm mt-1">Единый гоночный рейтинг и статистика участников соревнований и трек-дней</p>
    </div>
  </div>

  <!-- Pilots Ranking Table -->
  <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden shadow-2xl">
    <table class="w-full text-left text-sm text-slate-200">
      <thead class="bg-slate-950/60 text-xs uppercase text-slate-400 border-b border-slate-800">
        <tr>
          <th class="px-6 py-4 text-center w-12">Ранг</th>
          <th class="px-6 py-4">Пилот</th>
          <th class="px-6 py-4">Команда</th>
          <th class="px-6 py-4">Автомобиль</th>
          <th class="px-6 py-4 text-center">Старты</th>
          <th class="px-6 py-4 text-center">Победы</th>
          <th class="px-6 py-4 text-center">Подиумы</th>
          <th class="px-6 py-4 text-right">Очки рейтинга</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800/60">
        <% @pilots.each_with_index do |pilot, index| %>
          <tr class="hover:bg-slate-800/40 transition">
            <td class="px-6 py-4 text-center font-mono font-bold <%= index < 3 ? 'text-amber-400' : 'text-slate-500' %>">
              <%= index + 1 %>
            </td>
            <td class="px-6 py-4">
              <div class="font-semibold text-white">
                <%= link_to pilot.name, pilot_path(pilot), class: "hover:text-red-400 transition" %>
              </div>
              <div class="text-xs text-slate-500"><%= pilot.hometown.presence || "Россия" %></div>
            </td>
            <td class="px-6 py-4 text-slate-400">
              <% if pilot.team %>
                <%= link_to pilot.team.name, team_path(pilot.team.slug), class: "hover:text-slate-200" %>
              <% else %>
                —
              <% end %>
            </td>
            <td class="px-6 py-4 text-slate-300 font-mono text-xs"><%= pilot.car %></td>
            <td class="px-6 py-4 text-center font-mono text-slate-300"><%= pilot.starts_count %></td>
            <td class="px-6 py-4 text-center font-mono font-bold text-amber-400"><%= pilot.wins_count %></td>
            <td class="px-6 py-4 text-center font-mono text-slate-300"><%= pilot.podiums_count %></td>
            <td class="px-6 py-4 text-right font-mono font-extrabold text-red-500 text-base">
              <%= pilot.points %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
