<div class="space-y-8">
  <div class="bg-slate-900 border border-slate-800 p-6 rounded-xl">
    <h1 class="text-3xl font-extrabold text-white tracking-tight">Новости автоспорта и трек-дней</h1>
    <p class="text-slate-400 text-sm mt-1">События Чемпионатов RHHCC, MaxPowerCars, РСКГ, анонсы автодромов и регламенты</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @articles.each do |article| %>
      <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden flex flex-col justify-between hover:border-slate-700 transition-all">
        <div class="p-5">
          <div class="text-[11px] font-bold text-red-500 uppercase tracking-wider mb-2">
            <%= article.created_at.strftime("%d.%m.%Y") %>
          </div>
          <h2 class="text-lg font-bold text-white mb-2 leading-snug">
            <%= link_to article.title, blog_post_path(article.slug), class: "hover:text-red-400 transition-colors" %>
          </h2>
          <p class="text-xs text-slate-400 line-clamp-3 leading-relaxed">
            <%= article.summary || truncate(article.content, length: 120) %>
          </p>
        </div>
        <div class="px-5 py-3 border-t border-slate-800 text-right">
          <%= link_to "Подробнее →", blog_post_path(article.slug), class: "text-xs text-red-400 font-semibold hover:underline" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
