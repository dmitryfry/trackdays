<div class="max-w-3xl mx-auto space-y-8">
  <div>
    <%= link_to "← Ко всем статьям", blogs_path, class: "text-xs text-red-400 hover:underline" %>
    <div class="flex items-center gap-2 mt-3 mb-2">
      <span class="px-2.5 py-0.5 rounded text-xs font-bold uppercase tracking-wider bg-red-600/20 text-red-400 border border-red-500/30">
        <%= @article.category_title %>
      </span>
      <span class="text-xs text-slate-500">•</span>
      <span class="text-xs text-slate-400"><%= @article.created_at.strftime("%d %B %Y") %></span>
      <span class="text-xs text-slate-500">•</span>
      <span class="text-xs text-slate-400">👁 <%= @article.views_count %> просмотров</span>
    </div>
    <h1 class="text-3xl md:text-4xl font-black text-white tracking-tight leading-tight"><%= @article.title %></h1>
    
    <div class="flex items-center gap-3 mt-4 pt-4 border-t border-slate-800">
      <div class="w-10 h-10 rounded-full bg-slate-800 text-slate-200 font-bold flex items-center justify-center text-sm">
        <%= @article.user.name.first %>
      </div>
      <div>
        <div class="text-sm font-bold text-white"><%= @article.user.name %></div>
        <div class="text-xs text-slate-400"><%= @article.user.role_title %></div>
      </div>
    </div>
  </div>

  <% if @article.cover_image_url.present? %>
    <div class="rounded-2xl overflow-hidden border border-slate-800 max-h-96">
      <%= image_tag @article.cover_image_url, class: "w-full h-full object-cover", alt: @article.title %>
    </div>
  <% end %>

  <div class="prose prose-invert max-w-none text-slate-300 leading-relaxed text-sm md:text-base space-y-4 whitespace-pre-line bg-slate-900/50 border border-slate-800 p-6 md:p-8 rounded-2xl">
    <%= @article.content %>
  </div>

  <!-- Comments Section -->
  <div class="space-y-6 pt-6 border-t border-slate-800">
    <h2 class="text-xl font-bold text-white flex items-center gap-2">
      <span>Комментарии и обсуждение</span>
      <span class="text-xs px-2 py-0.5 rounded-full bg-slate-800 text-slate-400"><%= @article.comments.count %></span>
    </h2>

    <!-- New Comment Form -->
    <% if logged_in? %>
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-5">
        <%= form_with model: @comment, url: blog_post_comments_path(@article.slug), local: true, class: "space-y-3" do |f| %>
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Оставить комментарий от имени <%= current_user.name %></label>
            <%= f.text_area :body, rows: 3, placeholder: "Напишите ваши мысли, вопросы автору...", class: "w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-red-500", required: true %>
          </div>
          <div class="flex justify-end">
            <%= f.submit "Отправить", class: "px-4 py-2 bg-red-600 hover:bg-red-500 text-white rounded-lg text-xs font-semibold transition-colors cursor-pointer" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-slate-900/50 border border-slate-800 rounded-xl p-4 text-center text-xs text-slate-400">
        Чтобы оставить комментарий, пожалуйста, <%= link_to "войдите в аккаунт", login_path, class: "text-red-400 font-semibold hover:underline" %> или <%= link_to "зарегистрируйтесь", register_path, class: "text-red-400 font-semibold hover:underline" %>.
      </div>
    <% end %>

    <!-- Comments List -->
    <div class="space-y-4">
      <% @article.comments.each do |c| %>
        <div class="bg-slate-900 border border-slate-800/80 rounded-xl p-4">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-2">
              <span class="font-bold text-xs text-white"><%= c.user.name %></span>
              <span class="text-[10px] text-red-400 font-medium px-1.5 py-0.2 rounded bg-red-950/60 border border-red-900/50"><%= c.user.role_title %></span>
            </div>
            <span class="text-[11px] text-slate-500"><%= c.created_at.strftime("%d.%m.%Y %H:%M") %></span>
          </div>
          <p class="text-xs text-slate-300 leading-relaxed whitespace-pre-line"><%= c.body %></p>
        </div>
      <% end %>
    </div>
  </div>
</div>
